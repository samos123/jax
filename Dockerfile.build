# Use Ubuntu 22.04 as the base image
FROM ubuntu:22.04

# Avoid interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# Install build essentials, Python, pip, and other dependencies needed for JAX
RUN apt-get update && apt-get install -y \
    build-essential \
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    pip \
    git \
    curl \
    wget \
    lsb-release \
    software-properties-common \
    gnupg \
    # Add any other dependencies required by JAX and your build process
    # (e.g., Bazel, Clang, NumPy, etc.)
    && rm -rf /var/lib/apt/lists/*

# Set up a working directory
WORKDIR /build

# Copy your JAX source code into the container
# COPY . /build/jax_source

# ... Add commands to install Bazel, clang, etc. if not in base ...
# Example for clang  (adjust version as needed)
RUN wget https://apt.llvm.org/llvm.sh && chmod +x llvm.sh && ./llvm.sh 18 && rm llvm.sh

# ... Add commands to set up your build environment, e.g., virtualenv ...
RUN python3.10 -m venv /build/venv
ENV PATH="/build/venv/bin:$PATH"

# Install Python build dependencies
RUN pip install --upgrade pip setuptools wheel numpy

# Navigate to the JAX source directory
# Run the jaxlib build command (adjust as per your build.py script)
# Ensure you are using the clang inside the container if installed
# RUN python build/build.py build --wheels=jaxlib --local_xla_path=./xla --python_version=3.10 --clang_path=/usr/bin/clang-18 

